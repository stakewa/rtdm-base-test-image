# Example: localhost/reterminal-dm-base-bootc-fedora:build-1234
ARG LOCAL_BASE_IMAGE
FROM ${LOCAL_BASE_IMAGE}

# Automatic login as root
RUN mkdir -p /etc/systemd/system/getty@tty1.service.d && \
    printf '%s\n' \
      '[Service]' \
      'ExecStart=' \
      'ExecStart=-/sbin/agetty --autologin root --noclear - $TERM' \
      > /etc/systemd/system/getty@tty1.service.d/autologin.conf

RUN dnf install libinput-utils -y

# Clean up
RUN dnf clean all
RUN rm -rf /var/{log,cache,lib}/* /run/dnf

COPY /scripts /scripts

RUN printf '%s\n' 'To run the interactive testing script, execute: /bash/bin /scripts/interactive-testing.sh' > /etc/motd

RUN bootc container lint